classDiagram
    class GameLayout {
        +String title
        +String accentColor
        +String gradientEnd
        +String[] hints
        +InfoItem[] infoItems
        +Boolean confirmRestart
        +String tutorial
        +String entrance
        +String mood
        +Slot default
        +Slot controls
        +Slot header-extra
        +Event back
        +Event restart
    }

    class InfoItem {
        +String label
        +String|number value
    }

    class GameDialog {
        +Boolean visible
        +String accentColor
        +String icon
        +String title
        +String message
        +String actionText
        +Boolean newRecord
        +String achievementHint
        +StatItem[] stats
        +Slot icon
        +Slot default
        +Slot action
        +Event update:visible
        +Event action
    }

    class StatItem {
        +String label
        +String value
    }

    class DirectionPad {
        +String layout
        +Boolean showUp
        +Boolean showDown
        +Boolean repeat
        +Slot extra
        +Event up(isRepeat)
        +Event down(isRepeat)
        +Event left(isRepeat)
        +Event right(isRepeat)
    }

    class KeyBinding {
        +String|String[] key
        +Function handler
        +Boolean preventDefault
        +Boolean onKeyUp
        +RepeatOption repeat
    }

    class RepeatOption {
        +Number initialDelay
        +Number intervalMs
    }

    class UseGameKeyboardOptions {
        +KeyBinding[] bindings
        +Ref~Boolean~|Boolean active
    }

    class UseGameLoopOptions {
        +Function onUpdate
        +String mode
        +Number intervalMs
        +Number fixedStep
    }

    class useSound {
        +Ref~Boolean~ muted (readonly)
        +toggleMute() void
        +tone(freq, dur, type, vol, delay) void
        +sweep(f1, f2, dur, type, vol) void
        +click() void
        +move() void
        +push() void
        +place() void
        +select() void
        +match() void
        +eat() void
        +crash() void
        +drop() void
        +rotate() void
        +clear(lines) void
        +bounce() void
        +brick() void
        +loseLife() void
        +merge(level) void
        +hit() void
        +miss() void
        +collect() void
        +win() void
        +gameOver() void
        +pause() void
        +resume() void
        +unlock() void
    }

    class GameScore {
        +String name
        +Number score
        +String date
    }

    class useGameStore {
        +Ref~Record~String, GameScore[]~~ scores
        +addScore(game: String, score: Number) void
        +getTopScore(game: String) Number
    }

    GameLayout --> InfoItem : infoItems
    GameDialog --> StatItem : stats
    UseGameKeyboardOptions --> KeyBinding : bindings
    KeyBinding --> RepeatOption : repeat
    useGameStore --> GameScore : scores
    useGameStore --> localStorage : watch + sync

    note for GameLayout "restart 未声明在 emits 里，由 useAttrs 探测 $attrs.onRestart：\n绑定才渲染重启按钮，confirmRestart=true 时先弹二次确认"
    note for useSound "对外返回 muted(readonly)/toggleMute/tone + 全部音效预设；\nsweep 与 getCtx/createVoice 是模块内部实现，未随 return 导出"
